manifest {
    name            = 'GermlineQC'
    description     = 'Germline short-variant calling (BWA-MEM + GATK) with CAP/NABL-style analytical validation'
    author          = 'Balaji Madhavan'
    homePage        = 'https://github.com/balajimadhvn/GermlineQC'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.04.0'
    version         = '1.0.0'
}

params {
    input            = null
    validation_sheet = null
    fasta            = null
    panel_bed        = "${projectDir}/assets/panel_regions.bed"
    known_sites      = null
    gtf              = null
    clinvar          = null
    snpeff_genome    = 'GRCh38_panel'
    outdir           = 'results'
    help             = false
    // hard-filter thresholds follow the GATK germline recommendations
    snp_filter   = 'QD < 2.0 || FS > 60.0 || MQ < 40.0 || SOR > 3.0 || MQRankSum < -12.5 || ReadPosRankSum < -8.0'
    indel_filter = 'QD < 2.0 || FS > 200.0 || SOR > 10.0 || ReadPosRankSum < -20.0'
}

includeConfig 'conf/base.config'

profiles {
    local {
        // tools on PATH, e.g. after `conda activate germlineqc`
    }
    conda {
        conda.enabled  = true
        process.conda  = "${projectDir}/environment.yml"
    }
    test       { includeConfig 'conf/test.config' }
    validation { includeConfig 'conf/validation.config' }
}

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.tsv" }
