// Tiny bundled dataset: an 80 kb slice of chr20 (JAG1) with ~70x of real GIAB HG001 reads. Runs in a few minutes.
params {
    input     = "${projectDir}/tests/data/samplesheet.csv"
    fasta     = "${projectDir}/tests/data/ref.fa"
    panel_bed = "${projectDir}/tests/data/panel.bed"
    gtf       = "${projectDir}/tests/data/genes.gtf"
    clinvar   = "${projectDir}/tests/data/clinvar.vcf.gz"
    outdir    = 'results_test'
}
