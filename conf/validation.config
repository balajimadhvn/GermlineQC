// GIAB HG001 / HG002 panel slices produced by scripts/fetch_giab.sh + scripts/make_validation_set.py
params {
    validation_sheet = "${projectDir}/data/validation_samplesheet.csv"
    fasta            = "${projectDir}/data/ref/chr20.fa"
    panel_bed        = "${projectDir}/assets/panel_regions.bed"
    known_sites      = "${projectDir}/data/known_sites/1000G_phase1.snps.panel.vcf.gz,${projectDir}/data/known_sites/Mills_1000G.indels.panel.vcf.gz"
    gtf              = "${projectDir}/data/annotation/genes.chr20.gtf"
    clinvar          = "${projectDir}/data/annotation/clinvar.panel.vcf.gz"
    outdir           = 'results_validation'
}
