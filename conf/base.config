// Sized for a 16 GB laptop running other software: at most ~4 GB in use by the pipeline at once.
process {
    cpus   = 1
    memory = 1.5.GB
    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 1
    shell = ['/bin/bash', '-euo', 'pipefail']

    withLabel: 'heavy' { cpus = 2; memory = 3.GB }
    withLabel: 'light' { cpus = 1; memory = 1.5.GB }
}
executor { $local { cpus = 4; memory = '4 GB' } }
