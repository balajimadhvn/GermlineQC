// ACMG evidence resources produced by scripts/fetch_acmg_resources.sh (chr20)
params {
    fasta              = "${projectDir}/data/ref/chr20.fa"
    gtf                = "${projectDir}/data/annotation/genes.chr20.gtf"
    acmg_clinvar       = "${projectDir}/data/acmg/clinvar.chr20.vcf.gz"
    acmg_benchmark_vcf = "${projectDir}/data/acmg/clinvar_benchmark.vcf.gz"
    gnomad             = "${projectDir}/data/acmg/gnomad.exomes.vcf.gz,${projectDir}/data/acmg/gnomad.genomes.vcf.gz"
    revel              = "${projectDir}/data/acmg/revel.chr20.tsv.gz"
    clingen            = "${projectDir}/data/acmg/clingen_genes.tsv"
}
